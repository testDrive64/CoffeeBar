@using CoffeeBar.Services
@using CoffeeBar.Data.Models
@inject MemberService memberService;
@inject CoffeeService coffeeService;
@inject GelatoService gelatoService;
@inject DialogService dialogService;

@* Pays all open coffees and gelatos of a member together, after a confirmation. *@
<button class="cb-btn cb-btn-primary cb-btn-pay" @onclick="Pay" aria-label="Pay for @member.Name">
    <Icon Name="pay" /> Pay
</button>

@code {
    [Parameter, EditorRequired]
    public Member member { get; set; } = null!;
    [Parameter]
    public EventCallback OnPaid { get; set; }

    private async Task Pay() {
        int openCoffees = coffeeService.GetOpenCoffeeAmount(member);
        int openGelatos = gelatoService.GetOpenGelatoAmount(member);
        if (openCoffees == 0 && openGelatos == 0) {
            await dialogService.AlertAsync("Nothing to pay", $"{member.Name} has no open coffees or gelatos.");
            return;
        }

        double coffeeCost = openCoffees * memberService.CoffeePrice;
        double gelatoCost = openGelatos * memberService.GelatoPrice;
        var details = new List<DialogDetail>();
        if (openCoffees > 0)
            details.Add(new DialogDetail($"{openCoffees} × Coffee", $"{coffeeCost:0.00} €"));
        if (openGelatos > 0)
            details.Add(new DialogDetail($"{openGelatos} × Gelato", $"{gelatoCost:0.00} €"));

        bool confirmed = await dialogService.ConfirmAsync(new DialogOptions {
            Title = $"Pay for {member.Name}?",
            Details = details,
            Summary = new DialogDetail("Total", $"{Math.Round(coffeeCost + gelatoCost, 2):0.00} €"),
            ConfirmText = "Pay now",
            CancelText = "Cancel"
        });
        if (!confirmed)
            return;

        memberService.Pay(member, openCoffees, openGelatos);
        await OnPaid.InvokeAsync();
    }
}
