@page "/memberdetails/{id:int}"
@using CoffeeBar.Services
@using CoffeeBar.Data.Models
@using System.Globalization
@inject MemberService memberService
@inject CoffeeService coffeeService
@inject GelatoService gelatoService
@inject PayInfoService payInfoService
@inject NavigationManager navManager
@inject DialogService dialogService

@layout SampleLayout

@if (member == null)
{
    <PageTitle>Member not found · CoffeeBar</PageTitle>

    <div class="cb-card">
        <h2>Member not found</h2>
        <p class="cb-empty">This member does not exist (anymore).</p>
        <a class="cb-btn cb-btn-primary" href="coffeelist"><Icon Name="cup" /> Back to the coffee list</a>
    </div>
}
else
{
    <PageTitle>@member.Name · CoffeeBar</PageTitle>

    <div class="cb-page-head">
        <div>
            <h1><Icon Name="cup" Size="28" /> @member.Name</h1>
            <p>Member since @member.CreatedDate.ToGermanDate()</p>
        </div>
    </div>

    <div class="cb-stats">
        <div class="cb-card">
            <div class="cb-stat-value">@coffees.Count</div>
            <div class="cb-stat-label">coffees in total</div>
        </div>
        <div class="cb-card">
            <div class="cb-stat-value">@openCoffees</div>
            <div class="cb-stat-label">coffees open</div>
        </div>
        <div class="cb-card">
            <div class="cb-stat-value">@gelatoCount</div>
            <div class="cb-stat-label">gelatos in total</div>
        </div>
        <div class="cb-card">
            <div class="cb-stat-value">@totalPaid.ToString("0.00") €</div>
            <div class="cb-stat-label">paid in total</div>
        </div>
    </div>

    <div class="cb-card">
        <h2>Coffees per day and paid coffees</h2>
        @if (dates.Count == 0 && payDates.Count == 0)
        {
            <p class="cb-empty">No coffees yet.</p>
        }
        else
        {
            <ChartCanvas Config="chartConfig" Label="@($"Coffees per day and paid coffees of {member.Name}")" />
        }
    </div>

    <div class="cb-detail-grid">
        <div class="cb-card">
            <h2>Coffees per day</h2>
            @if (dates.Count == 0)
            {
                <p class="cb-empty">No coffees yet.</p>
            }
            else
            {
                <table class="cb-table">
                    <thead>
                        <tr><th>Date</th><th class="num">Coffee(s)</th></tr>
                    </thead>
                    <tbody>
                        @foreach (var day in dates.Reverse())
                        {
                            <tr>
                                <td>@day.Key.ToGermanDate()</td>
                                <td class="num">@day.Value</td>
                            </tr>
                        }
                    </tbody>
                </table>
            }
        </div>
        <div class="cb-card">
            <h2>Payments</h2>
            @if (payDates.Count == 0)
            {
                <p class="cb-empty">No payments yet.</p>
            }
            else
            {
                <table class="cb-table">
                    <thead>
                        <tr><th>Date</th><th class="num">Coffee(s)</th><th class="num">Price (€)</th></tr>
                    </thead>
                    <tbody>
                        @foreach (var payDate in Enumerable.Reverse(payDates))
                        {
                            <tr>
                                <td>@payDate.Created.ToGermanDate()</td>
                                <td class="num">@payDate.Amount</td>
                                <td class="num">@((payDate.CurrentCoffeePrice + payDate.CurrentGelatoPrice).ToString("0.00"))</td>
                            </tr>
                        }
                    </tbody>
                </table>
            }
        </div>
    </div>

    <div class="cb-card cb-danger-zone">
        <h2>Delete member</h2>
        @if (HasOpenCosts)
        {
            <p>@member.Name still has @openCoffees coffee(s) and @openGelatos gelato(s) open (@openCost.ToString("0.00") €).
               Pay first, then the member can be deleted.</p>
        }
        else
        {
            <p>Deletes @member.Name together with all coffees, gelatos and payments. This cannot be undone.</p>
        }
        @if (deleteError != null)
        {
            <div class="cb-form-error" role="alert">@deleteError</div>
        }
        <button class="cb-btn cb-btn-danger" @onclick="DeleteMember" disabled="@HasOpenCosts">
            <Icon Name="trash" /> Delete member
        </button>
    </div>
}

@code {
    [Parameter] public int Id { get; set; }

    private Member? member;
    private List<Coffee> coffees = new();
    private Dictionary<DateTime, int> dates = new();
    private List<PayInfo> payDates = new();
    private int openCoffees;
    private int openGelatos;
    private double openCost;
    private string? deleteError;
    private int gelatoCount;
    private double totalPaid;
    private object chartConfig = new();

    // Validated chart colors (see --coffee-chart / --brand-chart in site.css)
    private const string CoffeeColor = "#B06A2C";
    private const string PayColor = "#1F5BB5";
    private const string GridColor = "rgba(30, 36, 48, 0.08)";
    private const string TextColor = "#1E2430";
    private const string MutedColor = "#5B6573";

    private bool HasOpenCosts => openCoffees > 0 || openGelatos > 0;

    protected override void OnParametersSet() {
        LoadData();
    }

    private async Task DeleteMember() {
        if (member == null || HasOpenCosts)
            return;

        var memberId = member.Id;
        var memberName = member.Name;
        bool confirmed = await dialogService.ConfirmAsync(new DialogOptions {
            Title = $"Delete {memberName}?",
            Message = "The member is deleted together with all entries. This cannot be undone.",
            Details = new List<DialogDetail> {
                new("Coffees", coffees.Count.ToString()),
                new("Gelatos", gelatoCount.ToString()),
                new("Payments", payDates.Count.ToString())
            },
            ConfirmText = "Delete member",
            CancelText = "Cancel",
            Kind = DialogKind.Danger
        });
        if (!confirmed)
            return;

        switch (memberService.DeleteMember(memberId)) {
            case DeleteMemberResult.Deleted:
            case DeleteMemberResult.NotFound:
                navManager.NavigateTo("coffeelist");
                break;
            case DeleteMemberResult.HasOpenCosts:
                // Someone added a coffee or gelato in the meantime.
                LoadData();
                deleteError = $"{memberName} has open costs again. Pay first, then delete.";
                break;
        }
    }

    private void LoadData() {
        member = memberService.FindMember(Id);
        if (member == null)
            return;

        coffees = coffeeService.GetCoffeesById(Id);
        dates = coffeeService.GetDailyCoffeeAmount(member);
        payDates = payInfoService.GetPayInfos(member);
        openCoffees = coffeeService.GetOpenCoffeeAmount(member);
        openGelatos = gelatoService.GetOpenGelatoAmount(member);
        openCost = Math.Round(openCoffees * memberService.CoffeePrice + openGelatos * memberService.GelatoPrice, 2);
        gelatoCount = gelatoService.GetAmount(member);
        totalPaid = payDates.Sum(x => x.CurrentCoffeePrice + x.CurrentGelatoPrice);

        chartConfig = BuildChartConfig();
    }

    // Chart.js 4 configuration, serialized to JSON for wwwroot/js/charts.js.
    // Dates are sent as ISO strings without time zone, so the browser shows the same calendar day.
    private object BuildChartConfig() {
        static string Iso(DateTime value) => value.ToString("yyyy-MM-dd'T'HH:mm:ss", CultureInfo.InvariantCulture);

        return new {
            type = "line",
            data = new {
                datasets = new object[] {
                    new {
                        label = "Coffees per day",
                        data = dates.Select(day => new { x = Iso(day.Key), y = (double)day.Value }).ToArray(),
                        borderColor = CoffeeColor,
                        backgroundColor = CoffeeColor,
                        borderWidth = 2,
                        pointRadius = 4,
                        pointHoverRadius = 6,
                        pointHitRadius = 12,
                        tension = 0,
                        fill = false
                    },
                    new {
                        label = "Paid coffees",
                        data = payDates.Select(payInfo => new { x = Iso(payInfo.Created), y = payInfo.Amount }).ToArray(),
                        borderColor = PayColor,
                        backgroundColor = PayColor,
                        borderWidth = 2,
                        pointStyle = "rectRot",
                        pointRadius = 5,
                        pointHoverRadius = 7,
                        pointHitRadius = 12,
                        showLine = false,
                        fill = false
                    }
                }
            },
            options = new {
                responsive = true,
                interaction = new { mode = "nearest", intersect = false },
                plugins = new {
                    legend = new { position = "top", labels = new { usePointStyle = true, color = TextColor } }
                },
                scales = new {
                    x = new {
                        type = "time",
                        time = new {
                            unit = "day",
                            tooltipFormat = DateFormats.ChartDate,
                            displayFormats = new { day = DateFormats.ChartDate }
                        },
                        grid = new { display = false },
                        ticks = new { color = MutedColor }
                    },
                    y = new {
                        beginAtZero = true,
                        title = new { display = true, text = "Coffees", color = MutedColor },
                        grid = new { color = GridColor },
                        ticks = new { precision = 0, color = MutedColor }
                    }
                }
            }
        };
    }
}
