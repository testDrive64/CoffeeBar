@page "/coffeelist"
@using CoffeeBar.Services
@using CoffeeBar.Data.Models
@inject MemberService memberService;

<PageTitle>Coffee · CoffeeBar</PageTitle>

<div class="cb-page-head">
    <div>
        <h1><Icon Name="cup" Size="28" /> Coffee list</h1>
        <p>Tap <strong>+ Coffee</strong> for every cup. <strong>Pay</strong> settles coffee and gelato together.</p>
    </div>
    <a class="cb-btn cb-btn-outline" href="addmember"><Icon Name="user-add" /> Add member</a>
</div>

@if (team.Count == 0)
{
    <div class="cb-card"><p class="cb-empty">No members yet. Add the first one to start the coffee list.</p></div>
}
else
{
    <div class="cb-list">
        <div class="cb-list-head">
            <span>Member</span>
            <span class="num">Open</span>
            <span class="num">To pay</span>
            <span class="num">Total</span>
            <span class="actions">Actions</span>
        </div>
        @foreach (var member in team)
        {
            <CoffeeListItem @key="member.Id" member=member />
        }
    </div>
}

@code {
    private List<Member> team = new();

    protected override void OnInitialized() {
        team = memberService.GetMembers().OrderBy(x => x.Name).ToList();
    }
}
